// public/ as a static site, no build step. Every push to main deploys.
{
  "name": "tylerhannan-com",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  // /api/* and /embeddings.json come from ClickHouse Cloud; everything else is a static file.
  // Secrets (npx wrangler secret put): CLICKHOUSE_URL, CLICKHOUSE_SEARCH_PASSWORD (cloud/README.md)
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/embeddings.json"],
    // old WordPress links work with or without the slash
    "html_handling": "auto-trailing-slash",
    // unknown URLs get 404.html with a real 404
    "not_found_handling": "404-page"
  }
}
