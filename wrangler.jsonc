// Cloudflare Workers config: serves public/ as a static site, no build step.
// Connected to GitHub in the Cloudflare dashboard, so every push to main deploys.
{
  "name": "tylerhannan-com",
  "compatibility_date": "2026-10-01",
  // /api/search, /api/embed and /embeddings.json, answered by ClickHouse Cloud; everything else is a static file.
  // Secrets (npx wrangler secret put): CLICKHOUSE_URL, CLICKHOUSE_SEARCH_PASSWORD (cloud/README.md)
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/embeddings.json"],
    // /2012/04/geektool/ serves /2012/04/geektool/index.html, so old WordPress links keep working
    "html_handling": "auto-trailing-slash",
    // Unknown URLs get public/404.html with a real 404 status
    "not_found_handling": "404-page"
  }
}
