// public/ as a static site, no build step. Every push to main deploys.
{
  "name": "tylerhannan-com",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  // only /api/embed runs code; everything else is a static file
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    // old WordPress links work with or without the slash
    "html_handling": "auto-trailing-slash",
    // unknown URLs get 404.html with a real 404
    "not_found_handling": "404-page"
  },
  // Workers AI, for EmbeddingGemma
  "ai": { "binding": "AI" }
}
